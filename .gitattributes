# Normalizzazione automatica dei file di testo
* text=auto

# Markdown e sorgenti sempre LF, anche su Windows
*.md   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf

# Script Windows sempre CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# File binari
*.png  binary
*.jpg  binary
*.pdf  binary
*.pptx binary